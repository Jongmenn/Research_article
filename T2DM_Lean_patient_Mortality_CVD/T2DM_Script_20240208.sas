data a.tg_final_bmi; set a.tg_final11;
IF DTH_EVENT=1 THEN DTH_END=COMPRESS(SUBSTR(DTH_YYYY,1,4));
IF DTH_EVENT=0 THEN DTH_END=COMPRESS(2019);
IF CVD_EVENT=1 THEN CVD_END=COMPRESS(SUBSTR(CVD_MDCARE,1,4));
IF CVD_EVENT=0 THEN CVD_END=COMPRESS(2019);
IF CHD_EVENT=1 THEN CHD_END=COMPRESS(SUBSTR(CHD_MDCARE,1,4));
IF CHD_EVENT=0 THEN CHD_END=COMPRESS(2019);
IF HF_EVENT=1 THEN HF_END=COMPRESS(SUBSTR(HF_MDCARE,1,4));
IF HF_EVENT=0 THEN HF_END=COMPRESS(2019);
IF STROKE_EVENT=1 THEN STROKE_END=COMPRESS(SUBSTR(STROKE_MDCARE,1,4));
IF STROKE_EVENT=0 THEN STROKE_END=COMPRESS(2019);
IF HEMOSTROKE_EVENT=1 THEN HEMOSTROKE_END=COMPRESS(SUBSTR(HEMOSTROKE_MDCARE,1,4));
IF HEMOSTROKE_EVENT=0 THEN HEMOSTROKE_END=COMPRESS(2019);
IF ISCHSTROKE_EVENT=1 THEN ISCHSTROKE_END=COMPRESS(SUBSTR(ISCHSTROKE_MDCARE,1,4));
IF ISCHSTROKE_EVENT=0 THEN ISCHSTROKE_END=COMPRESS(2019);

BMI_KEY1=COMPRESS(DTH_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY2=COMPRESS(CVD_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY3=COMPRESS(CHD_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY4=COMPRESS(HF_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY5=COMPRESS(STROKE_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY6=COMPRESS(HEMOSTROKE_END)||("-")||COMPRESS(INDI_DSCM_NO);
BMI_KEY7=COMPRESS(ISCHSTROKE_END)||("-")||COMPRESS(INDI_DSCM_NO);
RUN;

proc freq data=a.tg_final_bmi; tables dth_end cvd_end chd_end hf_end stroke_end; run;


DATA a.end_G1EQ; set a.g1eq_2009-a.g1eq_2019;
RENAME HME_DT=END_HME_DT BMI=END_BMI;
IF BMI <18.5 THEN END_BMI_G2=1; ELSE IF
BMI>=18.5 & END_BMI_G2<23 THEN END_BMI_G2=2; ELSE IF
BMI>=25 THEN END_BMI_G2=4; ELSE END_BMI_G2=3;
END_YYYY=SUBSTR(HME_DT,1,4);
BMI_KEY=COMPRESS(END_YYYY)||("-")||COMPRESS(INDI_DSCM_NO);
keep INDI_DSCM_NO END_YYYY BMI END_BMI_G2 BMI_KEY;
RUN;

PROC SORT DATA=A.END_G1EQ NODUPKEY ;BY BMI_KEY; RUN;

/*1년 지연 걸고 연계*/
DATA A.END_G1EQ10; SET A.END_G1EQ; IF END_YYYY IN (2009); RUN;
DATA A.END_G1EQ11; SET A.END_G1EQ; IF END_YYYY IN (2010); RUN;
