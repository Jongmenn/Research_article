PROC SQL; CREATE TABLE A.T30_TRT_CNT AS SELECT CMN_KEY, 
sum(trt_dm) as TRT_DM,
sum(trt_HLD) as TRT_HLD,
sum(trt_HTN) as TRT_HTN,
sum(trt_Hormon) as TRT_Hormon
FROM A.T30_TRT09_19_U GROUP BY CMN_KEY; QUIT;

PROC FREQ DATA=A.T30_TRT_CNT; TABLES TRT_DM TRT_HLD TRT_Hormon TRT_HTN; RUN;

