ON A.CMN_KEY =B.CMN_KEY; QUIT;

DATA A.TG_FINAL11; SET A.TG_FINAL11;
IF TRT_DM="." THEN TRT_DM=0; 
IF TRT_HLD="." THEN TRT_HLD=0;
