DATA A.END_G1EQ15; SET A.END_G1EQ; IF END_YYYY IN (2014; RUN;
DATA A.END_G1EQ16; SET A.END_G1EQ; IF END_YYYY IN (2015; RUN;
DATA A.END_G1EQ17; SET A.END_G1EQ; IF END_YYYY IN (2016); RUN;
DATA A.END_G1EQ18; SET A.END_G1EQ; IF END_YYYY IN (2017); RUN;
DATA A.END_G1EQ19; SET A.END_G1EQ; IF END_YYYY IN (2018); RUN;

PROC SQL; CREATE TABLE ZZ AS SELECT *FROM A.TG_FINAL_BMI AS A LEFT JOIN Z AS B ON A.BMI_KEY1=B.BMI_KEY; QUIT;

DATA ZZ1; SET ZZ; IF END_BMI^="."; ; DROP BMI_KEY END_YYYY; RUN;
