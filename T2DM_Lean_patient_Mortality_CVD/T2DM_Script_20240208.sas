DATA A.TG_FINAL11 ; SET A.TG_FINAL11;
FORMAT CVD_DATE YYMMDD10.  HF_DATE  YYMMDD10. CHD_DATE  YYMMDD10. STROKE_DATE  YYMMDD10. HEMOSTROKE_DATE  YYMMDD10. ISCHSTROKE_DATE  YYMMDD10. ;
CVD_DATE              =MDY(SUBSTR(CVD_MDCARE,5,2),SUBSTR(CVD_MDCARE,7,2),SUBSTR(CVD_MDCARE,1,4));
HF_DATE                =MDY(SUBSTR(HF_MDCARE,5,2),SUBSTR(HF_MDCARE,7,2),SUBSTR(HF_MDCARE,1,4));
CHD_DATE              =MDY(SUBSTR(CHD_MDCARE,5,2),SUBSTR(CHD_MDCARE,7,2),SUBSTR(CHD_MDCARE,1,4));
STROKE_DATE        =MDY(SUBSTR(STROKE_MDCARE,5,2),SUBSTR(STROKE_MDCARE,7,2),SUBSTR(STROKE_MDCARE,1,4));
HEMOSTROKE_DATE=MDY(SUBSTR(HEMOSTROKE_MDCARE,5,2),SUBSTR(HEMOSTROKE_MDCARE,7,2),SUBSTR(HEMOSTROKE_MDCARE,1,4));
ISCHSTROKE_DATE  =MDY(SUBSTR(ISCHSTROKE_MDCARE,5,2),SUBSTR(ISCHSTROKE_MDCARE,7,2),SUBSTR(ISCHSTROKE_MDCARE,1,4));

CVD_TIME=CVD_DATE-HME_DATE;
HF_TIME =HF_DATE-HME_DATE;
CHD_TIME =CHD_DATE-HME_DATE;
STROKE_TIME =STROKE_DATE-HME_DATE;
HEMOSTROKE_TIME =HEMOSTROKE_DATE-HME_DATE;
ISCHSTROKE_TIME =ISCHSTROKE_DATE-HME_DATE;

IF CVD_DATE="" THEN CVD_EVENT=0; ELSE CVD_EVENT=1;
IF CVD_DATE="" THEN CVD_TIME=MDY(12,31,2019)-HME_DATE;
IF DTH_EVENT=1 & DTH_YYYY>2019 then DTH_EVENT=0;
IF DTH_EVENT=0 THEN DTH_TIME=MDY(12,31,2019)-HME_DATE; ELSE DTH_TIME=TIME;

IF HF_EVENT=0 THEN HF_TIME=MDY(12,31,2019)-HME_DATE; ELSE HF_TIME=HF_TIME;
IF CHD_EVENT=0 THEN CHD_TIME=MDY(12,31,2019)-HME_DATE; ELSE CHD_TIME=CHD_TIME;
IF STROKE_EVENT=0 THEN STROKE_TIME=MDY(12,31,2019)-HME_DATE; ELSE STROKE_TIME=STROKE_TIME;
IF HEMOSTROKE_EVENT=0 THEN HEMOSTROKE_TIME=MDY(12,31,2019)-HME_DATE; ELSE HEMOSTROKE_TIME=HEMOSTROKE_TIME;
IF ISCHSTROKE_EVENT=0 THEN ISCHSTROKE_TIME=MDY(12,31,2019)-HME_DATE; ELSE ISCHSTROKE_TIME=ISCHSTROKE_TIME;
IF CVD_TIME >0;
IF HF_TIME>0;
IF STROKE_TIME>0; 
IF CHD_TIME>0;
RUN;

PROC MEANS DATA=A.TG_FINAL11 N MEAN STD MIN P1 P5 P10 P25 P50 P75 P90 P95 P99 MAX; VAR CVD_TIME DTH_TIME; RUN;

