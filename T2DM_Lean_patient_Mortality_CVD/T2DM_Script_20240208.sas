PROC SQL; CREATE TABLE A.TG_FINAL5 AS SELECT * FROM A.TG_FINAL4 AS A LEFT JOIN  A.TRT09_19_U AS B ON A.PKEY=B.TRT_KEY;QUIT;

/*STD_~ : 처음 당뇨 진단 (상병코드 또는 검진 정보든)된 시점의 자격 정보*/
/*HME_~: 당뇨 진단 이후 최초 검진 시점의 자격정보*/
DATA A.TG_FINAL5 ; 
RETAIN INDI_DSCM_NO BYEAR STD_AGE HME_AGE;
RENAME SIDO=STD_SIDO SGG=STD_SGG GAIBJA=STD_GAIBJA INCOME_G=STD_INCOME_G;
SET A.TG_FINAL5;
IF TRT="." THEN TRT=0 ; 
HME_AGE=HME_YYYY-BYEAR;
HME_KEY=COMPRESS(HME_YYYY)||("-")||COMPRESS(INDI_DSCM_NO); 
DROP HME_YYYYmm;
RUN;
PROC FREQ DATA=A.TG_FINAL5; TABLES TRT; RUN;
PROC FREQ DATA=A.TG_FINAL5; TABLES STD_YYYY*HME_YYYY/LIST; RUN;

DATA A.BFC_HME; 
RENAME SIDO=HME_SIDO SGG=HME_SGG GAIBJA=HME_GAIBJA INCOME_G=HME_INCOME_G;
SET A.BFC; DROP AGE STD_YYYY; RUN;

PROC SQL; CREATE TABLE A.TG_FINAL6 AS SELECT * FROM A.TG_FINAL5 AS A LEFT JOIN  A.BFC_HME AS B ON A.HME_KEY=B.PKEY;QUIT;

/* 결과변수 추가연결, TIME 계산, 예비 분석*/
/*retinopathy (E113 or E143) 당뇨 망막병증*/
/*neuropathy (E114 or E144)*/
/*CVD evnets (I00-I99),
  CHD(I20-I25), 
  Stroke (I60-I64), 
  Hemorrhagic (I60-I62), 
  Ischmeic (I63)
  Heart failure (I50)
*/
/*index data: 당뇨 진단 이후 최초 검진일*/

/*자격 & 검진 MISSING 고려시 */
DATA A.TG_FINAL7; SET A.TG_FINAL6;

IF STD_AGE<30 THEN STD_AGE_G="<30    " ; ELSE IF
   STD_AGE<40 THEN STD_AGE_G="30-39"; ELSE IF
   STD_AGE<50 THEN STD_AGE_G="40-49"; ELSE IF
   STD_AGE<60 THEN STD_AGE_G="50-59"; ELSE IF
   STD_AGE<70 THEN STD_AGE_G="60-69"; ELSE IF
   STD_AGE<80 THEN STD_AGE_G="70-79"; ELSE 
   STD_AGE_G="80+";

IF HME_SIDO NOT IN (".",""); 
IF HME_GAIBJA NOT IN (".",""); 
IF HME_INCOME_G NOT IN (".","");
IF BMI NOT IN (".",""); 
IF SBP NOT IN (".",""); 
IF DBP NOT IN (".",""); 
IF FBS NOT IN (".",""); 
IF TCHOL NOT IN (".","");
IF TG   NOT IN (".","");
IF HDL NOT IN (".","");
IF LDL NOT IN (".","");
IF SMK NOT IN (".","");
IF DRK NOT IN (".","");
IF Q_PA_VD NOT IN (".","");
IF Q_PA_MD NOT IN (".","");
RUN;

PROC FREQ DATA=A.TG_FINAL7; TABLES Q_PA_VD; RUN;

/*검진 지표 이상치 제외 */
DATA A.TG_FINAL8; SET A.TG_FINAL7;
IF FBS      >=600   THEN DELETE; /*600이상은 응급실 수준*/
IF TCHOL  >=1000 THEN DELETE; /*1000 이상 제외*/
IF TG        >=1000 THEN DELETE; /*3~4000 정도 값이 나올수는 있으나 외국에서는 급성 췌장염 수준*/
IF HDL      >=200  THEN DELETE; 
IF LDL       >=400 THEN DELETE; /*4~500은 간질환인 경우, 300정도면 유전력*/
RUN;

