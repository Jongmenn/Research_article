/* --- RANK macro body, unmodified from SAS_healthage_250521.sas
   (label argument set to 1 for this single mock cohort) --- */
%MACRO RANK(DATA,K);
/*남성 100등분 등수 매겨서 산출*/
PROC RANK DATA=A.HA_M_&DATA. OUT=A.HA_M_&DATA. GROUPS=100;  VAR CVD_SCORE;  RANKS CVD_SCORE_RANK; RUN;
PROC SORT DATA=A.HA_M_&DATA.; BY CVD_SCORE_RANK; RUN;
PROC FREQ DATA=A.HA_M_&DATA.; TABLES CVD_SCORE_RANK; RUN;

PROC MEANS DATA=A.HA_M_&DATA. N MEAN STD MIN P25 P50 P75 MAX ;
VAR  G1E_BMI G1E_BP_SYS G1E_BP_DIA G1E_HGB G1E_FBS G1E_TOT_CHOL G1E_SGOT G1E_SGPT
G1E_GGT G1E_WSTC G1E_TG G1E_HDL G1E_LDL G1E_CRTN G1E_GFR TOTAL_FEE PRI_FEE INSUR_FEE;
CLASS CVD_SCORE_RANK;
OUTPUT OUT=A.SUMM_HA_M_&DATA.;
RUN;

/*여성 100등분 등수 매겨서 산출*/
PROC RANK DATA=A.HA_F_&DATA. OUT=A.HA_F_&DATA. GROUPS=100;  VAR CVD_SCORE;  RANKS CVD_SCORE_RANK; RUN;
PROC SORT DATA=A.HA_F_&DATA.; BY CVD_SCORE_RANK; RUN;
PROC FREQ DATA=A.HA_F_&DATA.; TABLES CVD_SCORE_RANK; RUN;

PROC MEANS DATA=A.HA_F_&DATA. N MEAN STD MIN P25 P50 P75 MAX ;
VAR  G1E_BMI G1E_BP_SYS G1E_BP_DIA G1E_HGB G1E_FBS G1E_TOT_CHOL G1E_SGOT G1E_SGPT
G1E_GGT G1E_WSTC G1E_TG G1E_HDL G1E_LDL G1E_CRTN G1E_GFR TOTAL_FEE PRI_FEE INSUR_FEE;
CLASS CVD_SCORE_RANK;
OUTPUT OUT=A.SUMM_HA_F_&DATA.;

DATA A.SUMM_HA_M_&DATA.; SET A.SUMM_HA_M_&DATA.; SEX="M"; LABEL=&K.; RUN;
DATA A.SUMM_HA_F_&DATA.; SET A.SUMM_HA_F_&DATA.; SEX="F"; LABEL=&K.; RUN;
RUN;
%MEND;

%RANK(FINAL, 1);

proc print data=a.ha_m_final(obs=8);
  title "RANK macro output: male cohort with CVD_SCORE percentile rank";
run;
proc print data=a.ha_f_final(obs=6);
  title "RANK macro output: female cohort with CVD_SCORE percentile rank";
run;
