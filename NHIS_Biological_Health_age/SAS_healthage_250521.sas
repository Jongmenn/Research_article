CREATE TABLE A.HA_CVD09 AS SELECT * FROM CONNECTION TO X1(
SELECT CMN_KEY, INDI_DSCM_NO, FORM_CD, MDCARE_STRT_DT, SICK_SYM1, SICK_SYM2 FROM NHISBASE.HBMV_TBGJME20
WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM HA_ID) AND HIRA_EXM_YYYYMM<='202411'
AND PAY_YN='1'
AND FORM_CD IN ('02','03') /*입원 또는 외래*/
