PROC SQL; CREATE TABLE A.HA_TG_Y16  AS SELECT * FROM A.HMDT2016 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y17  AS SELECT * FROM A.HMDT2017 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;

DATA A.HA_TG_Y12_17; SET A.HA_TG_Y12-A.HA_TG_Y17;
