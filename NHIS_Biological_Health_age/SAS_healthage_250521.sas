DATA A.HA_CVD11_14; SET A.HA_CVD11-A.HA_CVD14;
IF SUBSTR(SICK_SYM1,1,3) IN ("I20","I21","I22","I23","I24","I25","I60","I61","I62","I63","I64","I65","I66","I67","I68","I69") OR
   SUBSTR(SICK_SYM2,1,3) IN ("I20","I21","I22","I23","I24","I25","I60","I61","I62","I63","I64","I65","I66","I67","I68","I69");
RUN;

