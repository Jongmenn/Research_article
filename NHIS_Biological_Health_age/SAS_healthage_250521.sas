DATA A.HA13; SET A.BFC_HMDT_HA4;  IF SUBSTR(HME_DT,1,4)="2013"; KEEP INDI_DSCM_NO 	HME_DT; RUN;
DATA A.HA14; SET A.BFC_HMDT_HA4;  IF SUBSTR(HME_DT,1,4)="2014"; KEEP INDI_DSCM_NO 	HME_DT; RUN;

PROC SQL; CREATE TABLE A.HA_CVD_EX12 AS SELECT * FROM A.HA_CVD11_12 AS A LEFT JOIN A.HA12 AS B ON A.INDI_DSCM_NO=B.INDI_DSCM_NO; QUIT;
PROC SQL; CREATE TABLE A.HA_CVD_EX13 AS SELECT * FROM A.HA_CVD12_13 AS A LEFT JOIN A.HA13 AS B ON A.INDI_DSCM_NO=B.INDI_DSCM_NO; QUIT;
PROC SQL; CREATE TABLE A.HA_CVD_EX14 AS SELECT * FROM A.HA_CVD13_14 AS A LEFT JOIN A.HA14 AS B ON A.INDI_DSCM_NO=B.INDI_DSCM_NO; QUIT;

DATA A.HA_CVD_EX12; SET A.HA_CVD_EX12; 
IF HME_DT="" THEN DELETE;
MDATE=MDY(SUBSTR(MDCARE_STRT_DT,5,2),SUBSTR(MDCARE_STRT_DT,7,2),SUBSTR(MDCARE_STRT_DT,1,4));
HDATE =MDY(SUBSTR(HME_DT,5,2),SUBSTR(HME_DT,7,2),SUBSTR(HME_DT,1,4));
DIFF=HDATE-MDATE;
IF DIFF<=0 ;
FORMAT MDATE HDATE YYMMDD10.;
RUN;
DATA A.HA_CVD_EX13; SET A.HA_CVD_EX13; 
IF HME_DT="" THEN DELETE; 
MDATE=MDY(SUBSTR(MDCARE_STRT_DT,5,2),SUBSTR(MDCARE_STRT_DT,7,2),SUBSTR(MDCARE_STRT_DT,1,4));
HDATE =MDY(SUBSTR(HME_DT,5,2),SUBSTR(HME_DT,7,2),SUBSTR(HME_DT,1,4));
DIFF=HDATE-MDATE;
IF DIFF<=0 ;
FORMAT MDATE HDATE YYMMDD10.;
RUN;
DATA A.HA_CVD_EX14; SET A.HA_CVD_EX14; 
IF HME_DT="" THEN DELETE; 
MDATE=MDY(SUBSTR(MDCARE_STRT_DT,5,2),SUBSTR(MDCARE_STRT_DT,7,2),SUBSTR(MDCARE_STRT_DT,1,4));
HDATE =MDY(SUBSTR(HME_DT,5,2),SUBSTR(HME_DT,7,2),SUBSTR(HME_DT,1,4));
DIFF=HDATE-MDATE;
IF DIFF<=0 ;
FORMAT MDATE HDATE YYMMDD10.;
