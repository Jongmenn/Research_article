DATA A.HA_CVD12_13; SET A.HA_CVD10_13; IF SUBSTR(MDCARE_STRT_DT,1,4) IN ("2012","2013"); RUN;
DATA A.HA_CVD13_14; SET A.HA_CVD11_14; IF SUBSTR(MDCARE_STRT_DT,1,4) IN ("2013","2014"); RUN;

