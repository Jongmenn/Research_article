IF Q_PA_MD              NOT IN (".","");

IF G1E_WSTC>=35 & G1E_WSTC<125; /*선행연구 참조*/
IF G1E_BMI>=10 & G1E_BMI<40;
IF G1E_BP_SYS >=60 & G1E_BP_SYS<240;
IF G1E_BP_DIA  >=40 & G1E_BP_DIA<160;
IF G1E_HGB >=6 & G1E_HGB<20;
IF G1E_TG<1000;
IF G1E_FBS>= 40 & G1E_FBS <400;
IF G1E_TOT_CHOL>=40 & G1E_TOT_CHOL<400;
IF G1E_SGOT<200;
IF G1E_SGPT<200;
IF G1E_GGT<300;
IF G1E_HDL >=10 & G1E_HDL<200;
IF G1E_LDL <400;
IF G1E_CRTN <99.9; 
IF G1E_GFR <130; 

IF Q_PHX_DX_STK =1 THEN DELETE;    /*과거력/뇌졸중(중풍)/진단여부*/
IF Q_PHX_DX_HTDZ=1 THEN DELETE; /*과거력/심장병(심근경색/협심증)/진단여부*/
