PROC FREQ DATA=A.BFC_HMDT_HA8; TABLES SEX_TYPE*FHX_ETC/LIST; RUN;

DATA A.BFC_HMDT_HA8;  SET A.BFC_HMDT_HA8;
IF PA_VD_LOW=1 THEN PA_VD_G=0;
