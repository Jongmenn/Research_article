DATA A.BFC_HMDT_HA7;  SET A.BFC_HMDT_HA6;

/*DATE*/
HDATE  =MDY(SUBSTR(HME_DT,5,2),SUBSTR(HME_DT,7,2),SUBSTR(HME_DT,1,4));
MDATE1=MDY(SUBSTR(MDCARE1,5,2),SUBSTR(MDCARE1,7,2),SUBSTR(MDCARE1,1,4));
MDATE2=MDY(SUBSTR(MDCARE2,5,2),SUBSTR(MDCARE2,7,2),SUBSTR(MDCARE2,1,4));

/*OUTCOME*/
CVD_TIME1=MDATE1-HDATE;
CVD_TIME2=MDATE2-HDATE;
IF CVD_TIME1>=0 THEN CVD1=1; ELSE CVD1=0;
IF CVD_TIME2>=0 THEN CVD2=1; ELSE CVD2=0;

/*우선 심혈관 입원발생을 MAIN으로 분석수행*/
IF SUBSTR(HME_DT,1,4)="2012"           & CVD_TIME2="" THEN CVD_TIME2=MDY(12,31,2021)-HDATE; 
ELSE IF SUBSTR(HME_DT,1,4)="2013"  & CVD_TIME2="" THEN CVD_TIME2=MDY(12,31,2022)-HDATE; 
ELSE IF SUBSTR(HME_DT,1,4)="2014"  & CVD_TIME2="" THEN CVD_TIME2=MDY(12,31,2023)-HDATE; 
IF CVD_TIME2>=0;

/*BMI*/
IF G1E_BMI <18.5 THEN BMI_lean=1; else BMI_lean=0;
IF 18.5<=G1E_BMI<25 THEN BMI_NORMAL=1; ELSE BMI_NORMAL=0;
IF 25<=G1E_BMI <30 THEN BMI_OVER=1; ELSE BMI_OVER=0;
IF G1E_BMI>=30 THEN BMI_OBES=1; ELSE BMI_OBES=0; 

IF G1E_BMI <18.5 THEN BMI_G=1; else IF
G1E_BMI<25 THEN BMI_G=2; ELSE IF
G1E_BMI<30 THEN BMI_G=3; ELSE BMI_G=4;

/*SMK; Q_SMK_YN; 1:(거의)피우지않는다,2:과거에피웠으나지금은끊었다,3:현재도피운다 */
IF Q_SMK_YN=1 THEN SMK_rarely=1; else SMK_rarely=0;
IF Q_SMK_YN=2 THEN SMK_EX   =1; else SMK_EX=0;
IF Q_SMK_YN=3 THEN SMK_CUR=1; ELSE SMK_CUR=0;

/*DRK*/
IF Q_DRK_FRQ_V09N=0 THEN Q_DRK_AMT_V09N=0;

IF Q_DRK_FRQ_V09N>=0 THEN DO;
IF Q_DRK_AMT_V09N=0 THEN Q_DRK_AMT_V09N=".";
END;

/*일일 알콜섭취량(g)=횟수*총량(잔)*잔부피(cc)*술의 도수(%)*알코올비중(0.785)/7 */
avg_alcohol=(Q_DRK_FRQ_V09N*Q_DRK_AMT_V09N*50*0.2*0.785)/7;

IF AVG_alcohol<20 then alc_low=1; else alc_low=0;
IF 20<=AVG_alcohol <40 then alc_mod=1; else alc_mod=0;
if AVG_alcohol>=40 then alc_high=1; else alc_high=0;

if Q_DRK_FRQ_V09N=0 then DRK_G=0; ELSE IF
AVG_alcohol<20 then DRK_G=1; ELSE IF
AVG_alcohol<40 then DRK_G=2; ELSE DRK_G=3;

/*PA VD:고강도*/
IF Q_PA_VD=0 THEN PA_VD_low=1; else PA_VD_low=0;
IF 0<Q_PA_VD<3 THEN PA_VD_mid=1; else PA_VD_mid=0;
IF Q_PA_VD>=3 THEN PA_VD_high=1; ELSE PA_VD_high=0;

IF Q_PA_VD=0 THEN PA_VD_G=0; ELSE IF 
Q_PA_VD<3 THEN PA_VD_G=1; ELSE  PA_VD_G=2;

/*PA MD:저강도*/
IF Q_PA_MD=0 THEN PA_MD_low=1; else PA_MD_low=0;
IF 0<Q_PA_MD<3 THEN PA_MD_mid=1; else PA_MD_mid=0;
IF Q_PA_MD>=3 THEN PA_MD_high=1; ELSE PA_MD_high=0;

IF Q_PA_MD=0 THEN PA_MD_G=0; ELSE IF 
Q_PA_MD<3 THEN PA_MD_G=1; ELSE PA_MD_G=2;

/*가족력*/
IF Q_FHX_STK="1"   THEN FHX_STK=1   ; ELSE FHX_STK=0;    /*뇌졸중*/
IF Q_FHX_HTDZ="1" THEN FHX_HTDZ=1;  ELSE FHX_HTDZ=0;   /*심장병*/
IF Q_FHX_HTN ="1"  THEN FHX_HTN=1  ;  ELSE FHX_HTN=0;   /*고혈압*/
IF Q_FHX_DM="1"    THEN FHX_DM=1   ;   ELSE FHX_DM=0;  /*당뇨*/
IF Q_FHX_ETC="1"  THEN FHX_ETC=1   ;   ELSE FHX_ETC=0;  /*가족력 기타 (암포함)*/

FORMAT HDATE MDATE1 MDATE2 YYMMDD10.;
DROP MCARE1 MCARE2 CVD_DIFF1 CVD_DIFF2 Q_PHX_DX_STK Q_PHX_DX_HTDZ;
RUN;

/*사망 테이블 조회*/
PROC SQL;
&CONNECT.;
CREATE TABLE A.DTH AS SELECT INDI_DSCM_NO, DTH_ASSMD_DT FROM CONNECTION TO X1(
SELECT * FROM NHISBDA.HHDV_DEATH) ;
DISCONNECT FROM X1; QUIT;
DATA A.DTH12_23; SET A.DTH; IF SUBSTR(DTH_ASSMD_DT,1,4)>=2012;RUN;

