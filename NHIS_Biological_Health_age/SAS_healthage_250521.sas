/*연도별 10년 관찰하는 대상자 한에서 검진 몇번 수행하는지 검토*/
DATA A.HA_TG12; SET A.BFC_HMDT_HA8; IF STD_YYYY=2012; RUN;
DATA A.HA_TG13; SET A.BFC_HMDT_HA8; IF STD_YYYY=2013; RUN;
DATA A.HA_TG14; SET A.BFC_HMDT_HA8; IF STD_YYYY=2014; RUN;

/*18년 이후 검진은 명칭이 달라지니 17년까지 본다음에 18-23은 변수 축약해서 살펴보기*/
PROC SQL; CREATE TABLE A.HA_TG_Y12  AS SELECT * FROM A.HMDT2012 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y13  AS SELECT * FROM A.HMDT2013 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y14  AS SELECT * FROM A.HMDT2014 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y15  AS SELECT * FROM A.HMDT2015 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y16  AS SELECT * FROM A.HMDT2016 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;
PROC SQL; CREATE TABLE A.HA_TG_Y17  AS SELECT * FROM A.HMDT2017 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA8); QUIT;

DATA A.HA_TG_Y12_17; SET A.HA_TG_Y12-A.HA_TG_Y17;
IF G1E_WSTC           NOT IN (".","");
IF G1E_TG                NOT IN (".","");
IF G1E_BMI              NOT IN (".","");
IF G1E_BP_SYS        NOT IN (".","");
IF G1E_BP_DIA	      NOT IN (".","");
IF G1E_URN_PROT    NOT IN (".","");
IF G1E_HGB             NOT IN (".","");
IF G1E_FBS              NOT IN (".","");
IF G1E_TOT_CHOL    NOT IN (".","");
IF G1E_SGOT            NOT IN (".","");
IF G1E_SGPT            NOT IN (".","");
IF G1E_GGT              NOT IN (".","");
IF G1E_HDL               NOT IN (".","");
IF G1E_LDL                NOT IN (".","");
IF G1E_CRTN              NOT IN (".","");
IF G1E_GFR               NOT IN (".","");
IF Q_SMK_YN             NOT IN (".","");
IF Q_DRK_FRQ_V09N NOT IN (".","");
IF Q_PA_VD	            NOT IN (".","");
IF Q_PA_MD              NOT IN (".","");

IF G1E_WSTC>=35 & G1E_WSTC<125; /*선행연구 참조*/
IF G1E_BMI>=10 & G1E_BMI<40;
IF G1E_BP_SYS >=60 & G1E_BP_SYS<240;
IF G1E_BP_DIA  >=40 & G1E_BP_DIA<160;
IF G1E_HGB >=6 & G1E_HGB<20;
IF G1E_TG<1000;
IF G1E_FBS>= 40 & G1E_FBS <400;
IF G1E_TOT_CHOL>=40 & G1E_TOT_CHOL<400;
IF G1E_SGOT<200;
IF G1E_SGPT<200;
IF G1E_GGT<300;
IF G1E_HDL >=10 & G1E_HDL<200;
IF G1E_LDL <400;
IF G1E_CRTN <99.9; 
IF G1E_GFR <130; 

IF Q_PHX_DX_STK =1 THEN DELETE;    /*과거력/뇌졸중(중풍)/진단여부*/
IF Q_PHX_DX_HTDZ=1 THEN DELETE; /*과거력/심장병(심근경색/협심증)/진단여부*/
IF Q_PHX_TX_HTDZ=1 THEN DELETE;
IF Q_PHX_TX_HTN=1 THEN DELETE;

/*가족력*/
IF Q_FHX_STK="." THEN Q_FHX_STK=9;         /*뇌졸중*/
IF Q_FHX_HTDZ="." THEN Q_FHX_HTDZ=9; /*심장병*/
IF Q_FHX_HTN ="." THEN Q_FHX_HTN=9;   /*고혈압*/
IF Q_FHX_DM="." THEN Q_FHX_DM=9;      /*당뇨*/
IF Q_FHX_ETC="." THEN Q_FHX_ETC=9;     /*가족력 기타 (암포함)*/

/*BMI*/
IF G1E_BMI <18.5 THEN BMI_lean=1; else BMI_lean=0;
IF 18.5<=G1E_BMI<25 THEN BMI_NORMAL=1; ELSE BMI_NORMAL=0;
IF 25<=G1E_BMI <30 THEN BMI_OVER=1; ELSE BMI_OVER=0;
IF G1E_BMI>=30 THEN BMI_OBES=1; ELSE BMI_OBES=0; 

IF G1E_BMI <18.5 THEN BMI_G=1; else IF
G1E_BMI<25 THEN BMI_G=2; ELSE IF
G1E_BMI<30 THEN BMI_G=3; ELSE BMI_G=4;

/*SMK; Q_SMK_YN; 1:(거의)피우지않는다,2:과거에피웠으나지금은끊었다,3:현재도피운다 */
IF Q_SMK_YN=1 THEN SMK_rarely=1; else SMK_rarely=0;
IF Q_SMK_YN=2 THEN SMK_EX   =1; else SMK_EX=0;
IF Q_SMK_YN=3 THEN SMK_CUR=1; ELSE SMK_CUR=0;

/*DRK*/
IF Q_DRK_FRQ_V09N=0 THEN Q_DRK_AMT_V09N=0;

IF Q_DRK_FRQ_V09N>=0 THEN DO;
IF Q_DRK_AMT_V09N=0 THEN Q_DRK_AMT_V09N=".";
END;

/*일일 알콜섭취량(g)=횟수*총량(잔)*잔부피(cc)*술의 도수(%)*알코올비중(0.785)/7 */
avg_alcohol=(Q_DRK_FRQ_V09N*Q_DRK_AMT_V09N*50*0.2*0.785)/7;

IF AVG_alcohol<20 then alc_low=1; else alc_low=0;
IF 20<=AVG_alcohol <40 then alc_mod=1; else alc_mod=0;
if AVG_alcohol>=40 then alc_high=1; else alc_high=0;

if Q_DRK_FRQ_V09N=0 then DRK_G=0; ELSE IF
AVG_alcohol<20 then DRK_G=1; ELSE IF
AVG_alcohol<40 then DRK_G=2; ELSE DRK_G=3;

/*PA VD:고강도*/
IF Q_PA_VD=0 THEN PA_VD_low=1; else PA_VD_low=0;
IF 0<Q_PA_VD<3 THEN PA_VD_mid=1; else PA_VD_mid=0;
IF Q_PA_VD>=3 THEN PA_VD_high=1; ELSE PA_VD_high=0;

IF Q_PA_VD=0 THEN PA_VD_G=0; ELSE IF 
Q_PA_VD<3 THEN PA_VD_G=1; ELSE  PA_VD_G=2;

/*PA MD:저강도*/
IF Q_PA_MD=0 THEN PA_MD_low=1; else PA_MD_low=0;
IF 0<Q_PA_MD<3 THEN PA_MD_mid=1; else PA_MD_mid=0;
IF Q_PA_MD>=3 THEN PA_MD_high=1; ELSE PA_MD_high=0;

IF Q_PA_MD=0 THEN PA_MD_G=0; ELSE IF 
Q_PA_MD<3 THEN PA_MD_G=1; ELSE PA_MD_G=2;

/*가족력*/
