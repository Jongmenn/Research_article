/*2012~2014년 자격 대상자만*/
DATA A.BFC_HA_12_14; SET A.BFC_HA_REV12-A.BFC_HA_REV14; RUN;

PROC FREQ DATA=A.BFC_HA_12_14; TABLES SEX_TYPE*YEND_STD_AGE/LIST; RUN;
PROC FREQ DATA=A.BFC_HA_12_14; TABLES STD_YYYY*YEND_STD_AGE/LIST; RUN;

PROC SORT DATA=A.BFC_HA_12_14; BY DESCENDING STD_YYYY INDI_DSCM_NO; RUN;

/*중복 대상자 제외 */
/*매년 각 검진연도 시점에서 40세 이상 연구 대상자 포함*/
proc sort data=A.BFC_HA_12_14 NODUPKEY OUT=A.BFC_HA_12_14_U; BY INDI_DSCM_NO ; RUN;

PROC FREQ DATA=A.BFC_HA_12_14_U; TABLES STD_YYYY*YEND_STD_AGE/LIST; RUN;

/*일일 음주량은 주간 음주량에 비해 결측이 많음
주간 음주량 13,000건 정도 , 일일음주량은 5,168,479건-> 주간 음주량을 지표로 사용
*/
PROC FREQ DATA=A.HMDT2014; TABLES Q_DRK_FRQ_V09N  Q_DRK_AMT_V09N; RUN;

DATA A.BFC_HA_12_14_U; SET A.BFC_HA_12_14_U; 
KEY=COMPRESS(STD_YYYY)||("-")||COMPRESS(INDI_DSCM_NO);
RUN;

/*12~14년 검진 자료만 가져오기
G1E_WSTC: 허리둘레 */
DATA A.HMDT12_14; SET A.HMDT2012-A.HMDT2014; 
KEEP INDI_DSCM_NO HME_DT G1E_WSTC G1E_TG G1E_BMI G1E_BP_SYS G1E_BP_DIA  
G1E_URN_PROT /*요단백 1:음성(-);2:약양성(+-);3:양성(+1);4:양성(+2);5:양성(+3);6:양성(+4);*/
G1E_HGB         /*혈색소수치*/
G1E_FBS         /*공복혈당수치*/
G1E_TOT_CHOL 
G1E_HDL 
G1E_LDL 
G1E_CRTN       /*크레아티닌*/
G1E_SGOT     /*AST(SGOT)수치*/
G1E_SGPT     /*ALT(SGPT)수치*/
G1E_GGT       /*감마지피티수치*/
G1E_GFR      /*일반1차<혈액검사(신사구체여과율(e-GFR))>*/

Q_SMK_YN 
Q_DRK_FRQ_V09N
Q_DRK_AMT_V09N
Q_PA_VD
Q_PA_MD

/*과거력*/
Q_PHX_DX_STK	/*[문진1] 뇌졸증(중풍) 진단여부*/
Q_PHX_DX_HTDZ	/*[문진1] 심장병(심근경색/협심증) 진단여부*/
Q_PHX_DX_HTN	/*[문진1] 고혈압 진단여부*/
Q_PHX_DX_DM	    /*[문진1] 당뇨병 진단여부*/
Q_PHX_DX_DLD	/*[문진1] 이상지질혈증 진단여부*/
Q_PHX_DX_PTB	/*[문진1] 폐결핵 진단여부*/
Q_PHX_DX_ETC	/*[문진1] 기타(암포함) 진단여부*/
Q_PHX_TX_STK	/*[문진1] 뇌졸증(중풍) 약물치료여부*/
Q_PHX_TX_HTDZ	/*[문진1] 심장병(심근경색/협심증) 약물치료여부*/
Q_PHX_TX_HTN	/*[문진1] 고혈압 약물치료여부*/
Q_PHX_TX_DM	    /*[문진1] 당뇨병 약물치료여부*/
Q_PHX_TX_DLD	/*[문진1] 이상지질혈증 약물치료여부*/
Q_PHX_TX_PTB	/*[문진1] 폐결핵 약물치료여부*/
Q_PHX_TX_ETC	/*[문진1] 기타(암포함) 약물치료여부*/

/*가족력*/
Q_FHX_STK    /*뇌졸중*/
Q_FHX_HTDZ /*심장병*/
Q_FHX_HTN  /*고혈압*/
Q_FHX_DM   /*당뇨*/
Q_FHX_ETC   /*가족력/기타(암포함)*/
;
RUN;
DATA A.HMDT12_14; SET A.HMDT12_14;
KEY=COMPRESS(SUBSTR(HME_DT,1,4))||("-")||COMPRESS(INDI_DSCM_NO); 
DROP INDI_DSCM_NO; RUN;

/*12~14년도 처음 검진받은 40세 이상 대상자 Id만*/
DATA HA_ID; SET A.HMDT2012-A.HMDT2014; ; KEEP INDI_DSCM_NO; RUN;
PROC SORT DATA=HA_ID NODUPKEY OUT= A.HA_ID; BY INDI_DSCM_NO; RUN;

DATA SAPTMP.HA_ID; SET A.HA_ID; RUN;

