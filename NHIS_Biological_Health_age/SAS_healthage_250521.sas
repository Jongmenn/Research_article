/*PM2.5 연구부분*/
/*CVD Subtype 구분 (Ischemic heart disease and Stroke)*/
PROC SQL; CREATE TABLE A.HA_CVD_type AS SELECT * FROM A.HA_CVD12_23 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA); QUIT;

DATA A.HA_CVD_TYPE; SET A.HA_CVD_TYPE; IF FORM_CD="02"; RUN;
PROC SORT DATA=A.HA_CVD_TYPE ;BY INDI_DSCM_NO MDCARE_STRT_DT; RUN;

/*입원*/
PROC SORT DATA=A.HA_CVD_TYPE NODUPKEY OUT =A.HA_CVD_TYPE_U;BY INDI_DSCM_NO; RUN;

DATA A.HA_CVD_TYPE_U2 ; 
RENAME MDCARE_STRT_DT=MDCARE2;
SET A.HA_CVD_TYPE_U;
IF SUBSTR(SICK_SYM1,1,3) IN ("I20","I21","I22","I23","I24","I25") THEN IHD1=1; ELSE IHD1=0;
IF SUBSTR(SICK_SYM2,1,3) IN ("I20","I21","I22","I23","I24","I25") THEN IHD2=1; ELSE IHD2=0;

IF IHD1+IHD2>0 THEN IHD=1; ELSE IHD=0;

IF SUBSTR(SICK_SYM1,1,3) IN ("I60","I61","I62","I63","I64","I65","I66","I67","I68","I69") THEN STROKE1=1; ELSE STROKE1=0;
IF SUBSTR(SICK_SYM2,1,3)IN ("I60","I61","I62","I63","I64","I65","I66","I67","I68","I69") THEN STROKE2=1; ELSE STROKE2=0;

IF STROKE1+STROKE2>0 THEN STROKE=1; ELSE STROKE=0;
KEEP INDI_DSCM_NO SICK_SYM1 SICK_SYM2 IHD STROKE; 
RUN;

PROC FREQ DATA=A.HA_CVD_TYPE_U2; TABLES IHD STROKE; 

