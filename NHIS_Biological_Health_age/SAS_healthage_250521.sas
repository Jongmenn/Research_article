(LEFT(SICK_SYM1,2)='I2' OR LEFT(SICK_SYM1,2)='I6' OR LEFT(SICK_SYM2,2)='I2' OR
 LEFT(SICK_SYM2,2)='I6' OR LEFT(SICK_SYM3,2)='I2' OR LEFT(SICK_SYM3,2)='I6' OR
