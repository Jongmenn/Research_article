%MACRO RANK(DATA,K);
/*남성 100등분 등수 매겨서 산출*/
PROC RANK DATA=A.HA_M_&DATA. OUT=A.HA_M_&DATA. GROUPS=100;  VAR CVD_SCORE;  RANKS CVD_SCORE_RANK; RUN;
PROC SORT DATA=A.HA_M_&DATA.; BY CVD_SCORE_RANK; RUN;

PROC MEANS DATA=A.HA_M_&DATA. N  P50 ; 
VAR  TOTAL_FEE PRI_FEE INSUR_FEE;
CLASS CVD_SCORE_RANK; 
OUTPUT OUT=A.SUMM_HA_M_&DATA. MEDIAN=P50_TOTAL_FEE P50_PRI_FEE P50_INSUR_FEE;
RUN;

