PROC SQL; CREATE TABLE A.HA_CVD_type AS SELECT * FROM A.HA_CVD12_23 WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM A.BFC_HMDT_HA); QUIT;

/*입원*/
PROC SORT DATA=A.HA_CVD14_H NODUPKEY OUT =A.HA_CVD14_U2;BY INDI_DSCM_NO; RUN;

DATA A.HA_CVD_H1; RENAME MDCARE_STRT_DT=MDCARE1;
SET A.HA_CVD12_U1 A.HA_CVD13_U1 A.HA_CVD14_U1; KEEP INDI_DSCM_NO MDCARE_STRT_DT; RUN;
DATA A.HA_CVD_H2; ; RENAME MDCARE_STRT_DT=MDCARE2;
SET A.HA_CVD12_U2 A.HA_CVD13_U2 A.HA_CVD14_U2; KEEP INDI_DSCM_NO MDCARE_STRT_DT; RUN;

/* MDCARE1: 처음 입원또는 외래일; MDCARE2: 처음 입원일*/
PROC SQL; 
CREATE TABLE A.HA_CVD_HH AS SELECT * FROM A.HA_CVD_H1 AS A LEFT JOIN A.HA_CVD_H2 AS B ON A.INDI_DSCM_NO=B.INDI_DSCM_NO; 
QUIT;

PROC SQL; CREATE TABLE A.BFC_HMDT_HA6 AS SELECT * FROM A.BFC_HMDT_HA5 AS A LEFT JOIN A.HA_CVD_HH AS B ON  A.INDI_DSCM_NO=B.INDI_DSCM_NO; 
QUIT;

PROC FREQ DATA=A.BFC_HMDT_HA6; TABLES Q_SMK_YN Q_DRK_FRQ_V09N Q_PA_MD Q_PA_VD; RUN;


