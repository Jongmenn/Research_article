PROC SQL; 
&CONNECT.;
CREATE TABLE A.HA_T20_12 AS SELECT * FROM CONNECTION TO X1(
SELECT INDI_DSCM_NO, ED_RC_TOT_AMT, EDC_SBA, EDC_INSUR_BRDN_AMT FROM NHISBASE.HBMV_TBGJME20
WHERE INDI_DSCM_NO IN (SELECT INDI_DSCM_NO FROM HA_TG_F_ID) AND HIRA_EXM_YYYYMM<='202408'
AND PAY_YN='1'
AND MDCARE_STRT_YYYYMM IN 
('201201','201202','201203','201204','201205','201206','201207','201208','201209','201210','201211','201212')
 AND INDI_DSCM_NO <>0
 AND INDI_DSCM_NO IS NOT NULL
 AND INDI_DSCM_NO <90000000 
);
DISCONNECT FROM X1; QUIT;

