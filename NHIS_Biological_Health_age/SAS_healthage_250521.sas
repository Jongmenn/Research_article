PROC SORT DATA=A.HA_F_&DATA.; BY CVD_SCORE_RANK; RUN;

PROC MEANS DATA=A.HA_F_&DATA. N  P50 ; 
VAR  TOTAL_FEE PRI_FEE INSUR_FEE;
CLASS CVD_SCORE_RANK; 
OUTPUT OUT=A.SUMM_HA_F_&DATA. MEDIAN=P50_TOTAL_FEE P50_PRI_FEE P50_INSUR_FEE;
RUN;

