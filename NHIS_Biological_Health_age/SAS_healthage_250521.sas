A.KEY=B.KEY; QUIT;

PROC MEANS DATA=A.BFC_HMDT_HA N MEAN MIN P1 P5 P10  P25 P50 P75 P90 P95 P99 MAX; VAR  G1E_WSTC G1E_TG G1E_BMI G1E_BP_SYS G1E_BP_DIA	G1E_URN_PROT
G1E_HGB G1E_FBS G1E_TOT_CHOL G1E_SGOT G1E_SGPT G1E_GGT G1E_HDL G1E_LDL G1E_CRTN G1E_GFR;RUN;

PROC FREQ DATA=A.BFC_HMDT_HA ; TABLES Q_FHX_HTN Q_FHX_STK Q_FHX_HTDZ Q_FHX_DM Q_SMK_YN Q_PHX_DX_STK  Q_PHX_DX_HTDZ
Q_PHX_DX_HTN Q_PHX_DX_DM Q_PHX_DX_DLD Q_PHX_DX_ETC Q_PHX_TX_STK Q_PHX_TX_HTDZ
Q_PHX_TX_HTN Q_PHX_TX_DM Q_PHX_TX_DLD Q_PHX_TX_ETC Q_FHX_ETC Q_PHX_DX_PTB Q_PHX_TX_PTB;
RUN;

/*검진 지표 결측인 경우 제외하고 분석*/
DATA A.BFC_HMDT_HA2; SET A.BFC_HMDT_HA;
IF G1E_WSTC           NOT IN (".","");
IF G1E_TG                NOT IN (".","");
IF G1E_BMI              NOT IN (".","");
IF G1E_BP_SYS        NOT IN (".","");
IF G1E_BP_DIA	      NOT IN (".","");
IF G1E_URN_PROT    NOT IN (".","");
IF G1E_HGB             NOT IN (".","");
IF G1E_FBS              NOT IN (".","");
IF G1E_TOT_CHOL    NOT IN (".","");
IF G1E_SGOT            NOT IN (".","");
IF G1E_SGPT            NOT IN (".","");
IF G1E_GGT              NOT IN (".","");
IF G1E_HDL               NOT IN (".","");
IF G1E_LDL                NOT IN (".","");
IF G1E_CRTN              NOT IN (".","");
IF G1E_GFR               NOT IN (".","");
IF Q_SMK_YN             NOT IN (".","");
IF Q_DRK_FRQ_V09N NOT IN (".","");
IF Q_PA_VD	            NOT IN (".","");
IF Q_PA_MD              NOT IN (".","");
RUN;

/*검진 지표 유효 측정치; 공단 연구보고서 참고하여 정의*/
DATA A.BFC_HMDT_HA3; SET A.BFC_HMDT_HA2;
IF G1E_WSTC>=35 & G1E_WSTC<125; /*선행연구 참조*/
IF G1E_BMI>=10 & G1E_BMI<40;
IF G1E_BP_SYS >=60 & G1E_BP_SYS<240;
IF G1E_BP_DIA  >=40 & G1E_BP_DIA<160;
IF G1E_HGB >=6 & G1E_HGB<20;
IF G1E_FBS>= 40 & G1E_FBS <400;
IF G1E_TG <1000;
IF G1E_TOT_CHOL>=40 & G1E_TOT_CHOL<400;
IF G1E_SGOT<200;
IF G1E_SGPT<200;
IF G1E_GGT<300;
IF G1E_HDL >=10 & G1E_HDL<200;
IF G1E_LDL <400;
IF G1E_CRTN <99.9; 
IF G1E_GFR <130; 
RUN;

PROC MEANS DATA=A.BFC_HMDT_HA3 N MEAN MIN P1 P5 P10  P25 P50 P75 P90 P95 P99 MAX; VAR YEND_STD_AGE  G1E_WSTC G1E_TG G1E_BMI G1E_BP_SYS G1E_BP_DIA	G1E_URN_PROT
G1E_HGB G1E_FBS G1E_TOT_CHOL G1E_SGOT G1E_SGPT G1E_GGT G1E_HDL G1E_LDL G1E_CRTN G1E_GFR;RUN;
