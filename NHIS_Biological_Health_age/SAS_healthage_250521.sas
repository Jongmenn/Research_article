PROC SQL; CREATE TABLE A.HA_REV13 AS SELECT * FROM A.HA13 WHERE INDI_DSCM_NO NOT IN (SELECT INDI_DSCM_NO FROM A.HA_CVD_EX13);QUIT;
PROC SQL; CREATE TABLE A.HA_REV14 AS SELECT * FROM A.HA14 WHERE INDI_DSCM_NO NOT IN (SELECT INDI_DSCM_NO FROM A.HA_CVD_EX14);QUIT;

