IF G1E_FBS              NOT IN (".","");
IF G1E_TOT_CHOL    NOT IN (".","");
IF G1E_SGOT            NOT IN (".","");
IF G1E_SGPT            NOT IN (".","");
IF G1E_GGT              NOT IN (".","");
IF G1E_HDL               NOT IN (".","");
IF G1E_LDL                NOT IN (".","");
IF G1E_CRTN              NOT IN (".","");
IF G1E_GFR               NOT IN (".","");
IF Q_SMK_YN             NOT IN (".","");
IF Q_DRK_FRQ_V09N NOT IN (".","");
