IF PA_MD_G=2 THEN PA_MD_G2=1; ELSE PA_MD_G2=0;

SGG=SUBSTR(RVSN_ADDR_CD,1,5);

IF YEND_STD_AGE<50 THEN AG="40" ; ELSE IF
YEND_STD_AGE<60 THEN AG="50" ; ELSE IF 
