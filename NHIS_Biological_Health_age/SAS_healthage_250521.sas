DATA A.BFC_HMDT_HA_F2; SET A.BFC_HMDT_HA_F2;
IF PM25_M12 <23.91 THEN PM25_M12_Q=1; ELSE 
IF PM25_M12 <26.01 THEN PM25_M12_Q=2; ELSE
IF PM25_M12 <27.75 THEN PM25_M12_Q=3; ELSE PM25_M12_Q=4;

IF PM25_M24 <23.87 THEN PM25_M24_Q=1; ELSE 
